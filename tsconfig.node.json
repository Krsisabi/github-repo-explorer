// The build tooling, which the app's tsconfig does not include: its `include`
// is limited to `src` and `api`. `npm run typecheck` runs this project
// directly, because `tsc --noEmit` does not follow project references.
{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["vite.config.ts", "graphql-codegen.ts", "cypress.config.ts"]
}
