{
  "name": "github-repo-explorer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run codegen",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src api --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config graphql-codegen.ts",
    "codegen:watch": "graphql-codegen --config graphql-codegen.ts --watch",
    "schema": "node scripts/fetch-schema.mjs",
    "prepare:types": "npm run schema && npm run codegen",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@rtk-query/graphql-request-base-query": "^2.3.2",
    "clsx": "^2.1.1",
    "graphql": "^16.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/node": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^15.21.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-svgr": "^5.2.0"
  }
}
